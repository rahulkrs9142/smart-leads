            ],
            "url": {
              "raw": "{{baseUrl}}/api/leads?page=1&limit=10&status=&source=&search=&sort=latest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leads"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "" },
                { "key": "source", "value": "" },
                { "key": "search", "value": "" },
                { "key": "sort", "value": "latest" }
